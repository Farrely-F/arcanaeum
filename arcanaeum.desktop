[Desktop Entry]
Type=Application
Name=Arcanaeum
GenericName=Markdown Reader
Comment=Read markdown files in the terminal
# install.sh rewrites the terminal below to whichever one it finds on your system.
Exec=kitty --class arcanaeum -e arca %f
Icon=text-markdown
Terminal=false
Categories=Utility;TextTools;Viewer;
MimeType=text/markdown;text/x-markdown;
